/* =========================================================
   GYM MEMBERSHIP MANAGEMENT SYSTEM
   TABLE CREATION + 15 RECORDS IN EACH TABLE
   ========================================================= */


/* =========================
   1. CREATE MEMBER TABLE
   ========================= */

CREATE TABLE MEMBER
(
    MemberID NUMBER(5) PRIMARY KEY,
    FirstName VARCHAR2(30) NOT NULL,
    LastName VARCHAR2(30) NOT NULL,
    Gender CHAR(1) CHECK (Gender IN ('M','F')),
    DOB DATE NOT NULL
);


/* =========================
   2. CREATE MEMBER_PHONE
   ========================= */

CREATE TABLE MEMBER_PHONE
(
    MemberID NUMBER(5),
    Phone VARCHAR2(15),

    PRIMARY KEY (MemberID, Phone),

    FOREIGN KEY (MemberID)
    REFERENCES MEMBER(MemberID)
);


/* =========================
   3. CREATE TRAINER TABLE
   ========================= */

CREATE TABLE TRAINER
(
    TrainerID NUMBER(5) PRIMARY KEY,
    TrainerName VARCHAR2(40) NOT NULL,
    Specialization VARCHAR2(40) NOT NULL
);


/* =========================
   4. CREATE TRAINER_PHONE
   ========================= */

CREATE TABLE TRAINER_PHONE
(
    TrainerID NUMBER(5),
    Phone VARCHAR2(15),

    PRIMARY KEY (TrainerID, Phone),

    FOREIGN KEY (TrainerID)
    REFERENCES TRAINER(TrainerID)
);


/* =========================
   5. CREATE MEMBERSHIP TABLE
   ========================= */

CREATE TABLE MEMBERSHIP
(
    MembershipID NUMBER(5) PRIMARY KEY,
    MemberID NUMBER(5) NOT NULL,
    Plan VARCHAR2(20) NOT NULL,
    StartDate DATE NOT NULL,
    EndDate DATE NOT NULL,
    AssignedDate DATE NOT NULL,

    FOREIGN KEY (MemberID)
    REFERENCES MEMBER(MemberID),

    CHECK (EndDate >= StartDate)
);


/* =========================
   6. CREATE PAYMENT TABLE
   ========================= */

CREATE TABLE PAYMENT
(
    PaymentID NUMBER(5) PRIMARY KEY,
    MemberID NUMBER(5) NOT NULL,
    Amount NUMBER(10,2) CHECK (Amount > 0),
    PaymentDate DATE NOT NULL,
    PaymentMode VARCHAR2(15),

    FOREIGN KEY (MemberID)
    REFERENCES MEMBER(MemberID),

    CHECK (PaymentMode IN ('Cash','UPI','Card'))
);


/* =========================
   7. CREATE ATTENDANCE TABLE
   ========================= */

CREATE TABLE ATTENDANCE
(
    AttendanceID NUMBER(5) PRIMARY KEY,
    MemberID NUMBER(5) NOT NULL,
    AttendanceDate DATE NOT NULL,
    CheckIn VARCHAR2(8) NOT NULL,
    CheckInType VARCHAR2(15),

    FOREIGN KEY (MemberID)
    REFERENCES MEMBER(MemberID),

    CHECK (CheckInType IN ('Regular','Trainer'))
);


/* =========================
   8. CREATE WORKOUT TABLE
   ========================= */

CREATE TABLE WORKOUT
(
    WorkoutID NUMBER(5) PRIMARY KEY,
    TrainerID NUMBER(5) NOT NULL,
    WorkoutType VARCHAR2(40) NOT NULL,
    DurationWeeks NUMBER(3) CHECK (DurationWeeks > 0),
    FromDate DATE NOT NULL,
    ToDate DATE NOT NULL,

    FOREIGN KEY (TrainerID)
    REFERENCES TRAINER(TrainerID),

    CHECK (ToDate >= FromDate)
);


